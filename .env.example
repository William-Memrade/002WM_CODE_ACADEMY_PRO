# ============================================================================
# CodeAcademy Pro — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=CodeAcademy Pro
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Superuser connection — used for migrations only. NOT for the running app.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/academy_db
# RLS-enforced connection — used by the running application.
# This role has NO superuser/BYPASSRLS privileges, so RLS policies are enforced.
DATABASE_RLS_URL=postgresql+asyncpg://academy_app:academy_app_secure_pwd@localhost:5432/academy_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage (S3-compatible / Supabase Storage) ───────────────────────────────
STORAGE_BUCKET=academy-storage
STORAGE_SECRET=your-storage-secret
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@codeacademypro.com
SMTP_FROM_NAME=CodeAcademy Pro
SMTP_USE_TLS=false

# ── Security ─────────────────────────────────────────────────────────────────
MASTER_SERVICE_SECRET=your-internal-service-secret-for-hmac
RATE_LIMIT_PER_MINUTE=100
MAX_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=500
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ↑ Comma-separated allowed origins. Examples per environment:
#   development: http://localhost:3000,http://127.0.0.1:3000
#   staging:     https://staging.codeacademypro.com
#   production:  https://codeacademypro.com,https://www.codeacademypro.com
# ⚠️  NEVER use "*" in staging/production — the app will refuse to start.
CORS_MAX_AGE=600
# ↑ Preflight cache in seconds (600=dev, 3600=staging, 86400=prod)
SECURITY_HEADERS_ENABLED=true
# ↑ Master switch for security headers middleware. Set false to disable entirely.
HSTS_ENABLED=false
# ↑ Enable Strict-Transport-Security. Only when behind real HTTPS.
#   development: false (always — HSTS breaks local HTTP)
#   staging:     true
#   production:  true
HSTS_MAX_AGE=31536000
# ↑ HSTS duration in seconds (31536000 = 1 year, recommended minimum)
HSTS_INCLUDE_SUBDOMAINS=true
# ↑ Add includeSubDomains directive to HSTS header.
HSTS_PRELOAD=false
# ↑ Add preload directive to HSTS header.
# ⚠️  Only enable after validating at https://hstspreload.org
#   Requires: HSTS_INCLUDE_SUBDOMAINS=true, max-age >= 31536000,
#   and ALL subdomains must support HTTPS.
CSP_REPORT_ONLY=false
# ↑ Send CSP violations as reports instead of blocking.
#   development: false (permissive CSP, enforced)
#   staging:     true  (strict CSP in report-only mode for testing)
#   production:  false (strict CSP, enforced)
CSP_REPORT_URI=
# ↑ Endpoint for CSP violation reports (e.g., Sentry CSP ingest URL)

# ── reCAPTCHA (bot protection) ────────────────────────────────────────────────
# Google reCAPTCHA v2 checkbox. Required by the admin "create user" form and the
# "change temp password" flow to confirm a human is submitting the request.
# When RECAPTCHA_ENABLED=false, captcha verification is bypassed (use for dev).
# Frontend parallel var: NEXT_PUBLIC_RECAPTCHA_SITE_KEY (set in frontend .env.local).
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=

# ── Email Provider (production) ──────────────────────────────────────────────
EMAIL_PROVIDER_KEY=
