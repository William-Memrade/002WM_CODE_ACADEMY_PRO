# ============================================================================
# CodeAcademy Pro — .gitignore
# ============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
# .env.example SÍ se versiona: es la referencia de las variables que necesita el
# despliegue (Render/Supabase). Los valores reales nunca van al repo.
.env
.env.local
.env.*.local

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
pytest-cache-files-*/
htmlcov/
.coverage
*.cover

# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.nuxt/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ───────────────────────────────────────────────────────────────────
docker/postgres_data/
docker/redis_data/

# ── Uploads (local dev) ─────────────────────────────────────────────────────
uploads/
tmp/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Local Files ─────────────────────────────────────────────────────────────────────
*.txt

graphify-out/